{
  "name": "shipit",
  "version": "1.0.0",
  "description": "Production-grade URL shortener with click analytics, demonstrating full code-to-VPS deployment lifecycle",
  "main": "src/server.js",
  "type": "commonjs",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "migrate": "node src/db/migrate.js",
    "test": "jest --runInBand --detectOpenHandles --forceExit",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage"
  },
  "keywords": [
    "url-shortener",
    "express",
    "postgresql",
    "docker",
    "ci-cd",
    "devops",
    "nginx"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "morgan": "^1.10.0",
    "pg": "^8.13.3"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "supertest": "^7.0.0"
  },
  "overrides": {
    "braces": "^3.0.3"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
