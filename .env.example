# Environment Mode (development, test, production)
NODE_ENV=development

# Server Port
PORT=3000

# Base URL for generated short links
BASE_URL=http://localhost:3000

# PostgreSQL Database Configuration
# You can supply either DATABASE_URL or individual POSTGRES_* parameters
DATABASE_URL=
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=shipit
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_SSL=false

# Rate Limiting (in-memory)
# RATE_LIMIT_WINDOW_MS: 15 minutes = 900000 ms
RATE_LIMIT_WINDOW_MS=900000
# Maximum requests per IP per window for general endpoints
RATE_LIMIT_MAX=100
# Specific rate limit for link creation
RATE_LIMIT_CREATE_MAX=30
